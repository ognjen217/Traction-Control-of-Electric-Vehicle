            initial_filter_output = "0"
            wn_LPFdq = "1000"
            execution_rate = "inherit"
            _tunable = "False"
        }
    }

    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        Te=1e-6
        pi=np.pi
        
        
        Udc = 600                                   #[V]
        n = 2809                                    #[rpm]
        TempMot = 58                                #[degC]
        #Id = -300:1:0                          #[A]
        #Te=0:1:250                                  #[Nm]
        #Motor parameters
        #motor = 'PEV60-8(MD2032)' 
        TempMot0 = 25                               #[degC]
        Rs0 = 24.88e-3                              #[Ohm]
        Rs = Rs0*((TempMot+235)/(TempMot0+235))     #[Ohm]
        Ld = 0.59e-3                                #[H]
        Lq = 1.75e-3                                #[H]
        p = 4 
        Fpm = 0.243                                 #[Wb]
        Wn = n*p*2*pi/60                            #rad/s
        Un = Udc/1.7320                               #[V]
        In = 60                                     #[A]
        #Pmech = Te*n*2*pi/60/1000                   #[kW]
        P=4                 # Broj pari polova
        p=P 
        J=1                 # Moment inercije rotora
        
        
        # Dodatni podaci
        Ts=100e-6           # Prekidački period
        fs=1/Ts             # Prekidačka frekvencija
        
        # Bazne vrednosti
        Ub=Un               # Bazni napon
        Ib=In               # Bazna struja
        Wb=Wn 
        wb=Wb               # Bazna ugaona brzina
        Zb=Ub/Ib            # Bazna impedansa
        Fb=Ub/Wb            # Bazni fluks
        Mb=(P*Ub*Ib)/Wb     # Bazni moment
        
        
        # Normalizovane vrednosti
        rs=Rs/Zb            # Normalizovana otpornost statorskog namotaja
        td=Ld/Zb            # Normalizovana induktivnost statorskog namotaja po d osi
        tq=Lq/Zb            # Normalizovana induktivnost statorskog namotaja po q osi
        xd=Wb*Ld/Zb         # Normalizovana reaktansa statorskog namotaja po d osi
        xq=Wb*Lq/Zb         # Normalizovana reaktansa statorskog namotaja po q osi
        fpm=Fpm*Wb/Ub       # Normalizovan fluksni obuhvat statora
        
        
        # Strujni regulatori
        Ti=1000e-6           # Period izvrsavanja strujne petlje
        Lambda=2000         # Parametar koji definise brzinu odziva
        Kch=1               # Pojacanje pretvaraca u normalizovanom modelu
        K=1/rs              # Pojacanje u direktnoj grani uprostene petlje
        Td=td/rs            # Vremenska konstanta d ose
        Tq=tq/rs            # Vremenska konstanta q ose
        
        Kpid=0.0862 
        Kiid=0.0042 
        
        Kpiq=0.26 
        Kiiq=0.0042 
        
        # Brzinski regulator 
        Tw=10e-3             # Period izvrsavanja brzinske petlje
        Tmeh=(Wb*J)/(P*Mb)  # Mehanicka konstanta motora
        
        Ko=fpm*Tw/2/Tmeh 
        Zp=0.587 
        
        Kpw=Zp*Zp*Zp/Ko 
        Kiw=(3*Zp*Zp-1)/Ko 
        
        
        # obim tocka // prenosni odnos // eta
        
        Rw = 0.30
        ig = 3.5
        eta_g = 0.95
        
        Gain_v_wheel = Rw / ig         
        Gain_Rw_Tload = Rw / (ig * eta_g)
        
        
        # ogranicenje brzine
        omega_m_nom = n * 2*np.pi/60
        v_vehicle_max = 1.2 * omega_m_nom * Rw / ig
        
        
        #yaw dinamika
        tf = 1.55          # [m]
        Iz = 1800.0        # [kg m^2]
        cyaw = 300.0       # [N m s/rad]
        
        #slip control
        lambda_ref = 0.12
        lambda_on  = 0.14
        lambda_off = 0.125
        lambda_dead = 0.02
        
        #fizika na zemlji
        # Vehicle parameters
        g = 9.81
        m = 1200.0                 # [kg] masa vozila, prilagodi ako imaš zadatu
        front_static_ratio = 0.55  # deo težine na prednjoj osovini
        Fz = m * g * front_static_ratio / 2.0  # normalna sila po prednjem točku
        mi_default = 1.0
    ENDCODE
}
