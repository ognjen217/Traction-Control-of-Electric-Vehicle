        component "core/C function" pu_to_amp {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            execution_rate = "Tw"
            init_fnc = "/*Begin code section*/

/*End code section*/"
            input_terminals = "real iq_fl_pu;real iq_fr_pu;real enable;"
            input_terminals_dimensions = "inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True"
            input_terminals_show_labels = "True;True;True"
            output_fnc = "/*Begin code section*/
static double previous_fl_a = 0.0;
static double previous_fr_a = 0.0;

const double Ib_a = 60.0;
const double Iq_vehicle_max_a = 190.0;

/*
 * Tw = 0.01 s
 *
 * Povećavanje apsolutnog momenta:
 * 0.1 A/koraku = 10 A/s
 *
 * Smanjivanje apsolutnog momenta:
 * 0.4 A/koraku = 40 A/s
 */
const double Iq_apply_step_a = 2.0;
const double Iq_release_step_a = 4.0;

double target_fl_a;
double target_fr_a;
double difference;
double abs_target;
double abs_previous;
double allowed_step;

if (enable < 0.5)
{
    previous_fl_a = 0.0;
    previous_fr_a = 0.0;

    iq_fl_a = 0.0;
    iq_fr_a = 0.0;
}
else
{
    /* Pretvaranje iz pu u ampere. */
    target_fl_a = iq_fl_pu * Ib_a;
    target_fr_a = iq_fr_pu * Ib_a;

    /* Ograničenje maksimalne struje. */
    if (target_fl_a > Iq_vehicle_max_a)
        target_fl_a = Iq_vehicle_max_a;
    else if (target_fl_a < -Iq_vehicle_max_a)
        target_fl_a = -Iq_vehicle_max_a;

    if (target_fr_a > Iq_vehicle_max_a)
        target_fr_a = Iq_vehicle_max_a;
    else if (target_fr_a < -Iq_vehicle_max_a)
        target_fr_a = -Iq_vehicle_max_a;

    /*
     * FL: prilikom promene znaka struja prvo mora da
     * se vrati na nulu. Novi suprotan moment zatim
     * ponovo raste ograničenom brzinom.
     */
    if ((previous_fl_a > 0.0) && (target_fl_a < 0.0))
    {
        previous_fl_a -= Iq_release_step_a;

        if (previous_fl_a < 0.0)
            previous_fl_a = 0.0;
    }
    else if ((previous_fl_a < 0.0) && (target_fl_a > 0.0))
    {
        previous_fl_a += Iq_release_step_a;

        if (previous_fl_a > 0.0)
            previous_fl_a = 0.0;
    }
    else
    {
        abs_target =
            (target_fl_a >= 0.0) ? target_fl_a : -target_fl_a;

        abs_previous =
            (previous_fl_a >= 0.0) ? previous_fl_a : -previous_fl_a;

        allowed_step =
            (abs_target > abs_previous)
                ? Iq_apply_step_a
                : Iq_release_step_a;

        difference = target_fl_a - previous_fl_a;

        if (difference > allowed_step)
            difference = allowed_step;
        else if (difference < -allowed_step)
            difference = -allowed_step;

        previous_fl_a += difference;
    }

    /* Ista logika za FR. */
    if ((previous_fr_a > 0.0) && (target_fr_a < 0.0))
    {
        previous_fr_a -= Iq_release_step_a;

        if (previous_fr_a < 0.0)
            previous_fr_a = 0.0;
    }
    else if ((previous_fr_a < 0.0) && (target_fr_a > 0.0))
    {
        previous_fr_a += Iq_release_step_a;

        if (previous_fr_a > 0.0)
            previous_fr_a = 0.0;
    }
    else
    {
        abs_target =
            (target_fr_a >= 0.0) ? target_fr_a : -target_fr_a;

        abs_previous =
            (previous_fr_a >= 0.0) ? previous_fr_a : -previous_fr_a;

        allowed_step =
            (abs_target > abs_previous)
                ? Iq_apply_step_a
                : Iq_release_step_a;

        difference = target_fr_a - previous_fr_a;

        if (difference > allowed_step)
            difference = allowed_step;
        else if (difference < -allowed_step)
            difference = -allowed_step;

        previous_fr_a += difference;
    }

    iq_fl_a = previous_fl_a;
    iq_fr_a = previous_fr_a;
}
/*End code section*/"
