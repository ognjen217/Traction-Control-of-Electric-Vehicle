        component Subsystem slip_controller {
            layout = dynamic
            component "core/C function" slip_controller {
                arb_defs = "/*Begin code section*/

/*End code section*/"
                init_fnc = "/*Begin code section*/

/*End code section*/"
                input_terminals = "real slip_FL;real slip_FR;"
                input_terminals_dimensions = "inherit;inherit"
                input_terminals_feedthrough = "True;True"
                input_terminals_show_labels = "True;True"
                output_fnc = "/*Begin code section*/
/* Slip controller with hysteresis
   Inputs:
       slip_FL
       slip_FR

   Outputs:
       delta_iq_slip_FL
       delta_iq_slip_FR
       tc_active
*/

double lambda_ref = 0.12;

/* Hysteresis thresholds:
   ON threshold  = lambda_ref + lambda_on_band  = 0.14
   OFF threshold = lambda_ref + lambda_off_band = 0.125

   This means:
   - TC activates when slip > 0.14
   - TC stays active until slip falls below 0.125
*/
double lambda_on_band  = 0.02;
double lambda_off_band = 0.005;

double lambda_on  = lambda_ref + lambda_on_band;
double lambda_off = lambda_ref + lambda_off_band;

double Kslip_iq = 120.0;   /* A per slip unit */

/* Persistent latch states */
static int tc_fl_active = 0;
static int tc_fr_active = 0;

/* -----------------------------
   FL hysteresis logic
   ----------------------------- */
if (tc_fl_active == 0) {
    if (slip_FL > lambda_on) {
        tc_fl_active = 1;
    }
} else {
    if (slip_FL < lambda_off) {
        tc_fl_active = 0;
    }
}

/* -----------------------------
   FR hysteresis logic
   ----------------------------- */
if (tc_fr_active == 0) {
    if (slip_FR > lambda_on) {
        tc_fr_active = 1;
    }
} else {
    if (slip_FR < lambda_off) {
        tc_fr_active = 0;
    }
}

/* -----------------------------
   Reduction calculation
   ----------------------------- */
delta_iq_slip_FL = 0.0;
delta_iq_slip_FR = 0.0;

if (tc_fl_active == 1) {
    double e_fl = slip_FL - lambda_ref;

    if (e_fl < 0.0) {
        e_fl = 0.0;
    }

    delta_iq_slip_FL = Kslip_iq * e_fl;
}

if (tc_fr_active == 1) {
    double e_fr = slip_FR - lambda_ref;

    if (e_fr < 0.0) {
        e_fr = 0.0;
    }

    delta_iq_slip_FR = Kslip_iq * e_fr;
}

/* -----------------------------
   Activity flag
   ----------------------------- */
tc_active = 0.0;

if ((tc_fl_active == 1) || (tc_fr_active == 1)) {
    tc_active = 1.0;
}
/*End code section*/"
                output_terminals = "real delta_iq_slip_FL;real delta_iq_slip_FR;real tc_active;"
