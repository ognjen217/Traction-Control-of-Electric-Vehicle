        component "core/C function" restore_iq_sign {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            execution_rate = "Ti"
            init_fnc = "/*Begin code section*/

/*End code section*/"
            input_terminals = "real iq_mag_FL;real iq_mag_FR;real iq_driver_FL;real iq_driver_FR;real tc_enable;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True"
            output_fnc = "/*Begin code section*/
double eps = 0.001;
double driver_mag_fl;
double driver_mag_fr;
double controller_mag_fl;
double controller_mag_fr;

/*
 * Magnitude originalne signed struje regulatora brzine.
 */
if (iq_driver_FL >= 0.0)
{
    driver_mag_fl = iq_driver_FL;
}
else
{
    driver_mag_fl = -iq_driver_FL;
}

if (iq_driver_FR >= 0.0)
{
    driver_mag_fr = iq_driver_FR;
}
else
{
    driver_mag_fr = -iq_driver_FR;
}

/*
 * tc_enable = 0:
 * Potpuno zaobilaženje spoljašnjeg traction kontrolera.
 * Originalna signed struja regulatora brzine direktno se
 * prosleđuje strujnim regulatorima motora.
 */
if (tc_enable < 0.5)
{
    iq_signed_FL = iq_driver_FL;
    iq_signed_FR = iq_driver_FR;
}
else
{
    /*
     * tc_enable = 1:
     * Koristi se magnituda vraćena sa MCU traction
     * kontrolera.
     */
    controller_mag_fl = iq_mag_FL;
    controller_mag_fr = iq_mag_FR;

    /*
     * Zaštita od NaN vrednosti.
     */
    if (controller_mag_fl != controller_mag_fl)
    {
        controller_mag_fl = 0.0;
    }

    if (controller_mag_fr != controller_mag_fr)
    {
        controller_mag_fr = 0.0;
    }

    /*
     * Magnituda ne sme biti negativna.
     */
    if (controller_mag_fl < 0.0)
    {
        controller_mag_fl = 0.0;
    }

    if (controller_mag_fr < 0.0)
    {
        controller_mag_fr = 0.0;
    }

    /*
     * Traction controller sme samo da smanji struju.
     * Zbog toga struja vraćena sa MCU-a ne sme biti veća
     * od originalnog zahteva regulatora brzine.
     *
     * Ovo takođe uklanja manja prekoračenja nastala zbog
     * AO/ADC/PWM-DAC kalibracije.
     */
    if (controller_mag_fl > driver_mag_fl)
    {
        controller_mag_fl = driver_mag_fl;
    }

    if (controller_mag_fr > driver_mag_fr)
    {
        controller_mag_fr = driver_mag_fr;
    }

    /*
     * Vraćanje znaka originalne driver komande.
     */
    if (iq_driver_FL > eps)
    {
        iq_signed_FL = controller_mag_fl;
    }
    else if (iq_driver_FL < -eps)
    {
        iq_signed_FL = -controller_mag_fl;
    }
    else
    {
        iq_signed_FL = 0.0;
    }

    if (iq_driver_FR > eps)
    {
        iq_signed_FR = controller_mag_fr;
    }
    else if (iq_driver_FR < -eps)
    {
        iq_signed_FR = -controller_mag_fr;
    }
    else
    {
        iq_signed_FR = 0.0;
    }
}
/*End code section*/"
            output_terminals = "real iq_signed_FL;real iq_signed_FR;"
            output_terminals_dimensions = "inherit;inherit"
            output_terminals_feedthrough = "True;True"
            output_terminals_show_labels = "True;True"
            update_fnc = "/*Begin code section*/

/*End code section*/"
