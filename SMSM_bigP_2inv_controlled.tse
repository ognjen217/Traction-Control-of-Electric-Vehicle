/*End code section*/"
                input_terminals = "real iq_driver_FL;real iq_driver_FR;real delta_iq_slip_FL;real delta_iq_slip_FR;real delta_iq_yaw_FL;real delta_iq_yaw_FR;real tc_active;real yaw_active;"
                input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True;True;True;True;True;True"
                input_terminals_show_labels = "True;True;True;True;True;True;True;True"
                output_fnc = "/*Begin code section*/
double iq_min = 0.0;
double iq_max = 60.0;

double iq_fl_driver = iq_driver_FL;
double iq_fr_driver = iq_driver_FR;

/* Saturacija driver komandi */
if (iq_fl_driver < iq_min) {
    iq_fl_driver = iq_min;
}
if (iq_fl_driver > iq_max) {
    iq_fl_driver = iq_max;
}

if (iq_fr_driver < iq_min) {
    iq_fr_driver = iq_min;
}
if (iq_fr_driver > iq_max) {
    iq_fr_driver = iq_max;
}

/* Koristi active signale kao gating */
double dslip_fl = 0.0;
double dslip_fr = 0.0;
double dyaw_fl = 0.0;
double dyaw_fr = 0.0;

if (tc_active > 0.5) {
    dslip_fl = delta_iq_slip_FL;
    dslip_fr = delta_iq_slip_FR;
}

if (yaw_active > 0.5) {
    dyaw_fl = delta_iq_yaw_FL;
    dyaw_fr = delta_iq_yaw_FR;
}

/* Reduction-only logika */
double iq_fl_raw = iq_fl_driver - dslip_fl - dyaw_fl;
double iq_fr_raw = iq_fr_driver - dslip_fr - dyaw_fr;

/* Saturacija finalnih safe referenci */
iq_ref_FL_safe = iq_fl_raw;
iq_ref_FR_safe = iq_fr_raw;

if (iq_ref_FL_safe < iq_min) {
    iq_ref_FL_safe = iq_min;
}
if (iq_ref_FL_safe > iq_fl_driver) {
    iq_ref_FL_safe = iq_fl_driver;
}

if (iq_ref_FR_safe < iq_min) {
    iq_ref_FR_safe = iq_min;
}
if (iq_ref_FR_safe > iq_fr_driver) {
    iq_ref_FR_safe = iq_fr_driver;
}

/* Režimski signal */
safety_active = 0.0;

if ((tc_active > 0.5) || (yaw_active > 0.5)) {
    safety_active = 1.0;
}
/*End code section*/"
