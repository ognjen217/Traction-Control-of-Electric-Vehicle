            component "core/C function" "noise funct" {
                arb_defs = "/*Begin code section*/

/*End code section*/"
                execution_rate = "Ts"
                init_fnc = "/*Begin code section*/

/*End code section*/"
                input_terminals = "real slip_FL_true;real slip_FR_true;real noise_std;real reset;"
                input_terminals_dimensions = "inherit;inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True;True"
                input_terminals_show_labels = "True;True;True;True"
                output_fnc = "/*Begin code section*/
/* ============================================================
 * SLIP SENSOR NOISE MODEL
 *
 * Inputs:
 *   slip_FL_true
 *   slip_FR_true
 *   noise_std
 *   reset
 *
 * Outputs:
 *   slip_FL_noisy
 *   slip_FR_noisy
 *   noise_FL
 *   noise_FR
 * ============================================================ */


/* Persistent pseudo-random generator state */
static unsigned int tc_noise_seed = 0x12345678;


/* Local variables */
double u1;
double u2;

double r;
double theta;

double z_fl;
double z_fr;

double noisy_fl;
double noisy_fr;

double sigma;


/* Prevent negative standard deviation */
sigma = noise_std;

if (sigma < 0.0)
{
    sigma = 0.0;
}


/* ============================================================
 * Deterministic PRNG reset
 * ============================================================ */

if (reset > 0.5)
{
    tc_noise_seed = 0x12345678;

    noise_FL = 0.0;
    noise_FR = 0.0;

    slip_FL_noisy = slip_FL_true;
    slip_FR_noisy = slip_FR_true;
}
else
{
    /* ========================================================
     * Uniform random sample U1
     *
     * LCG:
     * x[k+1] = 1664525*x[k] + 1013904223
     * ======================================================== */

    tc_noise_seed =
        1664525 * tc_noise_seed
        + 1013904223;

    u1 =
        ((double)tc_noise_seed + 1.0)
        / 4294967297.0;


    /* ========================================================
     * Uniform random sample U2
     * ======================================================== */

    tc_noise_seed =
        1664525 * tc_noise_seed
        + 1013904223;

    u2 =
        ((double)tc_noise_seed + 1.0)
        / 4294967297.0;


    /* Protect logarithm */
    if (u1 < 1.0e-12)
    {
        u1 = 1.0e-12;
    }


    /* ========================================================
     * Box-Muller transform
     *
     * z_fl, z_fr ~ N(0,1)
     * ======================================================== */

    r =
        sqrt(
            -2.0 * log(u1)
        );

    theta =
        6.283185307179586 * u2;

    z_fl =
        r * cos(theta);

    z_fr =
        r * sin(theta);


    /* Scale to desired standard deviation */

    noise_FL =
        sigma * z_fl;

    noise_FR =
        sigma * z_fr;


    /* Add measurement noise */

    noisy_fl =
        slip_FL_true + noise_FL;

    noisy_fr =
        slip_FR_true + noise_FR;


    /* Clamp measured slip */

    if (noisy_fl > 1.0)
    {
        noisy_fl = 1.0;
    }
    else if (noisy_fl < -1.0)
    {
        noisy_fl = -1.0;
    }


    if (noisy_fr > 1.0)
    {
        noisy_fr = 1.0;
    }
    else if (noisy_fr < -1.0)
    {
        noisy_fr = -1.0;
    }


    /* Outputs */

    slip_FL_noisy = noisy_fl;
    slip_FR_noisy = noisy_fr;
}
/*End code section*/"
                output_terminals = "real slip_FL_noisy;real slip_FR_noisy;real noise_FL;real noise_FR;"
                output_terminals_dimensions = "inherit;inherit;inherit;inherit"
                output_terminals_feedthrough = "True;True;True;True"
                output_terminals_show_labels = "True;True;True;True"
                update_fnc = "/*Begin code section*/

