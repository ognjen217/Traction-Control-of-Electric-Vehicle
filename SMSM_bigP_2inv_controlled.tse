            component "core/C function" SpeedPI_FL {
                arb_defs = "/*Begin code section*/

/*End code section*/"
                execution_rate = "Tw"
                init_fnc = "/*Begin code section*/

/*End code section*/"
                input_terminals = "real speed_enable;real n_command_pu;real n_measured_pu;"
                input_terminals_dimensions = "inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True"
                input_terminals_show_labels = "True;True;True"
                output_fnc = "/*Begin code section*/
/*
 * Diskretna stanja regulatora.
 *
 * iq_previous predstavlja izlaz bloka UD1/UD2.
 * speed_previous predstavlja prethodni ulaz bloka
 * DTFdc/DTFdc1.
 */
static double iq_previous = 0.0;
static double speed_previous = 0.0;

/*
 * Originalni parametri regulatora iz modela:
 *
 * Kpw = Zp^3 / Ko
 * Kiw = (3*Zp^2 - 1) / Ko
 *
 * Za postojeće parametre modela:
 * Kpw = 693.017381
 * Kiw = 115.491474
 */
const double Kpw_old = 693.017381;
const double Kiw_old = 115.491474;

/* Originalni limit izlaza regulatora. */
const double Iq_upper_limit = 4.0;
const double Iq_lower_limit = -4.0;

double speed_difference;
double iq_unsaturated;

/*
 * Regulator radi samo kada je speed_enable = 1.
 */
if (speed_enable > 0.5)
{
    /*
     * Sum11/Sum20:
     *
     * e[k] = n_ref[k] - n[k]
     */
    speed_error_pu =
        n_command_pu - n_measured_pu;

    /*
     * Gain26 + DTFdc, odnosno Gain41 + DTFdc1:
     *
     * Kpw * (n[k] - n[k-1])
     */
    speed_difference =
        n_measured_pu - speed_previous;

    /*
     * Sum13/Sum21:
     *
     * u[k] =
     *     u[k-1]
     *     + Kiw * e[k]
     *     - Kpw * (n[k] - n[k-1])
     */
    iq_unsaturated =
        iq_previous +
        Kiw_old * speed_error_pu -
        Kpw_old * speed_difference;

    /*
     * Limit1/Limit2:
     * ograničenje izlaza na opseg -4 do +4.
     */
    iq_driver_a = iq_unsaturated;

    if (iq_driver_a > Iq_upper_limit)
    {
        iq_driver_a = Iq_upper_limit;
    }
    else if (iq_driver_a < Iq_lower_limit)
    {
        iq_driver_a = Iq_lower_limit;
    }

    /*
     * UD1/UD2 pamti ograničeni izlaz regulatora.
     */
    iq_previous = iq_driver_a;

    /*
     * DTFdc/DTFdc1 pamti prethodnu brzinu.
     */
    speed_previous = n_measured_pu;
}
else
{
    /*
     * Kada je regulator isključen:
     * - izlaz se postavlja na nulu;
     * - memorija izlaza se resetuje;
     * - prethodna brzina prati trenutnu brzinu.
     *
     * Poslednja stavka sprečava veliki diferencijalni
     * udar pri ponovnom uključivanju.
     */
    iq_driver_a = 0.0;
    speed_error_pu = 0.0;

    iq_previous = 0.0;
    speed_previous = n_measured_pu;
}
/*End code section*/"
                output_terminals = "real iq_driver_a;inherit speed_error_pu;"
                output_terminals_dimensions = "inherit;inherit"
                output_terminals_feedthrough = "True;True"
