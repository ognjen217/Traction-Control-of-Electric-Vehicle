        <component_data>
                <id>91739014bd104e4ab56be95bb80ecfd7</id>
                <name><![CDATA[STEP_FL_LOW_auto_test3]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ============================================================
# AW01_SAT_RELEASE
# Anti-windup / saturation recovery test
#
# 0.0 s   reset state, mu = 0.8 / 0.8, nr = 1.10
# 0.5 s   motor ON
# 1.0 s   speed control ON
# 2.5 s   mu = 0.05 / 0.05  -> force severe slip / saturation
# 7.5 s   mu = 0.8 / 0.8    -> sudden release
# 12.0 s  speed control OFF
# 12.5 s  motor OFF
# 13.0 s  reset references
# ============================================================

NR_HIGH = 1.10

MU_HIGH = 0.80
MU_SAT  = 0.05


# ------------------------------------------------------------
# Initial state - t = 0.0 s
# ------------------------------------------------------------

hil.model_write("motor_enable", 0)
