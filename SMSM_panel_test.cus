        <component_data>
                <id>a6da8cc2a5714991ae21b03db6182830</id>
                <name><![CDATA[STEP_FL_LOW_auto_test7]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ============================================================
# SR01_STEP_RESPONSE_STEADY_STATE
#
# Purpose:
#   Measure:
#       - steady-state error
#       - control rise time
#       - slip capture time
#       - settling time
#       - overshoot / peak slip
#       - steady-state oscillation
#       - current oscillation
#
# Timeline:
#
# 0.0 s   reset
#         mu = 0.80 / 0.80
#         nr = 0.35
#         motor OFF
#         speed control OFF
#         noise OFF
#
# 0.5 s   motor ON
#
# 1.0 s   speed control ON
#         vehicle settles toward low initial speed
#
# 5.0 s   STEP:
#         nr -> 1.10
#         mu -> 0.20 / 0.20
#
# 5.0 ... 15.0 s
#         sustained low-mu/high-torque condition
#
# 12.0 ... 15.0 s
#         nominal steady-state analysis window
#
# 15.0 s  recovery:
#         mu -> 0.80 / 0.80
#
# 18.0 s  speed control OFF
#
# 18.5 s  motor OFF
#
# 19.0 s  reset
# ============================================================


# ============================================================
# PARAMETERS
# ============================================================

NR_INITIAL = 0.35
NR_HIGH    = 1.10

MU_HIGH = 0.80
MU_TEST = 0.20


# ============================================================
# Helper
# ============================================================

def set_mu(mu_fl, mu_fr, label):

    hil.model_write(
        "road_surface_model.mu_scalefl",
        mu_fl
    )

    hil.model_write(
        "road_surface_model.mu_scalefr",
        mu_fr
    )

    print(
        "SR01 | {} | mu = {:.2f} / {:.2f}".format(
            label,
            mu_fl,
            mu_fr
        )
    )


# ============================================================
# t = 0.0 s
# Initial state
# ============================================================

hil.model_write(
    "motor_enable",
    0
)

hil.model_write(
    "speed_enable",
    0
)

hil.model_write(
    "tc_enable",
    1
)

hil.model_write(
    "nr",
    NR_INITIAL
)

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 0.00 s | INITIAL"
)


# ------------------------------------------------------------
# Measurement noise OFF
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.noise std",
    0.0
)


# ------------------------------------------------------------
# Deterministic reset of noise model
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)


print(
    "SR01 | t = 0.00 s | RESET | "
    "nr = {:.2f}".format(NR_INITIAL)
)


# ============================================================
# t = 0.5 s
# Motor ON
# ============================================================

hil.wait_msec(490)

hil.model_write(
    "motor_enable",
    1
)

print(
    "SR01 | t = 0.50 s | MOTOR ON"
)


# ============================================================
# t = 1.0 s
# Speed control ON
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "speed_enable",
    1
)

print(
    "SR01 | t = 1.00 s | "
    "SPEED CONTROL ON | "
    "nr = {:.2f}".format(NR_INITIAL)
)


# ============================================================
# t = 1.0 ... 5.0 s
# Initial operating-point stabilization
# ============================================================

hil.wait_msec(4000)


# ============================================================
# t = 5.0 s
# MAIN STEP
#
# Simultaneously:
#
#   nr: 0.35 -> 1.10
#   mu: 0.80 -> 0.20
#
# Creates strong positive drive-torque demand and sustained
# traction-control operation.
# ============================================================

hil.model_write(
    "nr",
    NR_HIGH
)

set_mu(
    MU_TEST,
    MU_TEST,
    "t = 5.00 s | MAIN STEP"
)

print(
    "SR01 | t = 5.00 s | "
    "nr: {:.2f} -> {:.2f}".format(
        NR_INITIAL,
        NR_HIGH
    )
)


# ============================================================
# t = 5.0 ... 15.0 s
#
# Long observation window
#
# Recommended analysis:
#
#   5.0 ... 7.0 s
#       early transient
#
#   5.0 ... 15.0 s
#       complete disturbance response
#
#   12.0 ... 15.0 s
#       steady-state / oscillation analysis
#
# ============================================================

hil.wait_msec(10000)


# ============================================================
# t = 15.0 s
# Recovery
# ============================================================

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 15.00 s | RECOVERY"
)


# ============================================================
# t = 15.0 ... 18.0 s
# Recovery observation
# ============================================================

hil.wait_msec(3000)


# ============================================================
# t = 18.0 s
# Speed control OFF
# ============================================================

hil.model_write(
    "speed_enable",
    0
)

print(
    "SR01 | t = 18.00 s | SPEED CONTROL OFF"
)


# ============================================================
# t = 18.5 s
# Motor OFF
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "motor_enable",
    0
)

print(
    "SR01 | t = 18.50 s | MOTOR OFF"
)


# ============================================================
# t = 19.0 s
# Reset system
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "nr",
    0.0
)

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 19.00 s | RESET"
)

hil.model_write(
    "road_surface_model.noise std",
    0.0
)

hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)

print(
    "SR01 | TEST COMPLETE"
)]]></on_click_code>
