hil.wait_msec(5000)


# ------------------------------------------------------------
# t = 7.5 s - sudden recovery
#
# IMPORTANT:
# motor_enable stays ON
# speed_enable stays ON
# nr stays at 1.10
#
# Therefore the controller state is NOT reset.
# ------------------------------------------------------------

