# ------------------------------------------------------------
# t = 2.5 s - severe low-mu event
# ------------------------------------------------------------

hil.wait_msec(1500)

hil.model_write("road_surface_model.mu_scalefl", MU_SAT)
hil.model_write("road_surface_model.mu_scalefr", MU_SAT)

print("AW01 | t = 2.5 s | SATURATION EVENT | mu = 0.05 / 0.05")


# ------------------------------------------------------------
# Hold severe low-mu condition for 5 s
# t = 2.5 ... 7.5 s
