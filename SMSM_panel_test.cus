# t = 12.0 s - speed control OFF
# ------------------------------------------------------------

hil.model_write("speed_enable", 0)

print("AW01 | t = 12.0 s | SPEED CONTROL OFF")


# ------------------------------------------------------------
# t = 12.5 s - motor OFF
# ------------------------------------------------------------

hil.wait_msec(500)

hil.model_write("motor_enable", 0)

print("AW01 | t = 12.5 s | MOTOR OFF")


# ------------------------------------------------------------
# t = 13.0 s - return SCADA references to safe initial state
# ------------------------------------------------------------

hil.wait_msec(500)

hil.model_write("nr", 0.0)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

print("AW01 | t = 13.0 s | TEST COMPLETE")]]></on_click_code>
