        <component_data>
                <id>302306486eff4099918d2f0a5e2a2598</id>
                <name><![CDATA[STEP_FL_LOW_auto_test6]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ============================================================
# TE01_TRACTION_EFFICIENCY
#
# Traction-performance / traction-efficiency test
#
# Timeline:
#
# 0.0 s   reset
#         mu = 0.80 / 0.80
#         nr = 0.35
#         motor OFF
#         speed control OFF
#         noise OFF
#
# 0.5 s   motor ON
#
# 1.0 s   speed control ON
#         vehicle accelerates toward low initial setpoint
#
# 5.0 s   TRACTION TEST START:
#         nr -> 1.10
#         mu -> 0.20 / 0.20
#
# 5.0 ... 11.0 s
#         low-mu acceleration window
#
# 11.0 s  recovery:
#         mu -> 0.80 / 0.80
#
# 13.0 s  speed control OFF
#
# 13.5 s  motor OFF
#
# 14.0 s  reset
# ============================================================


# ============================================================
# PARAMETERS
# ============================================================

NR_INITIAL = 0.35
NR_HIGH    = 1.10

MU_HIGH = 0.80
MU_TEST = 0.20


# ============================================================
# Helper
# ============================================================

def set_mu(mu_fl, mu_fr, label):
    hil.model_write(
        "road_surface_model.mu_scalefl",
        mu_fl
    )

    hil.model_write(
        "road_surface_model.mu_scalefr",
        mu_fr
    )

    print(
        "TE01 | {} | mu = {:.2f} / {:.2f}".format(
            label,
            mu_fl,
            mu_fr
        )
    )


# ============================================================
# t = 0.0 s
# Clean initial state
# ============================================================

hil.model_write(
    "motor_enable",
    0
)

hil.model_write(
    "speed_enable",
    0
)

hil.model_write(
    "tc_enable",
    1
)

hil.model_write(
    "nr",
    NR_INITIAL
)

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 0.00 s | INITIAL"
)


# ------------------------------------------------------------
# Disable measurement noise
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.noise std",
    0.0
)


# ------------------------------------------------------------
# Deterministically reset noise model / PRNG
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)


print(
    "TE01 | t = 0.00 s | RESET | "
    "nr = {:.2f}".format(NR_INITIAL)
)


# ============================================================
# t = 0.5 s
# Motor ON
#
# 10 ms already elapsed during reset.
# ============================================================

hil.wait_msec(490)

hil.model_write(
    "motor_enable",
    1
)

print(
    "TE01 | t = 0.50 s | MOTOR ON"
)


# ============================================================
# t = 1.0 s
# Speed control ON
#
# Vehicle settles toward lower initial speed reference.
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "speed_enable",
    1
)

print(
    "TE01 | t = 1.00 s | "
    "SPEED CONTROL ON | "
    "nr = {:.2f}".format(NR_INITIAL)
)


# ============================================================
# t = 5.0 s
# TRACTION EFFICIENCY TEST START
#
# In the same instant:
#
#   1) increase speed demand
#   2) reduce road friction on both driven wheels
#
# This creates a strong positive torque demand while traction
# is limited by the road surface.
# ============================================================

hil.wait_msec(4000)

hil.model_write(
    "nr",
    NR_HIGH
)

set_mu(
    MU_TEST,
    MU_TEST,
    "t = 5.00 s | TRACTION TEST START"
)

print(
    "TE01 | t = 5.00 s | "
    "nr: {:.2f} -> {:.2f}".format(
        NR_INITIAL,
        NR_HIGH
    )
)


# ============================================================
# t = 5.0 ... 11.0 s
#
# Main traction-performance measurement window.
#
# Important analysis windows:
#
#   5.0 ... 9.0 s   = first 4 seconds
#   5.0 ... 11.0 s  = full 6 seconds
#
# ============================================================

hil.wait_msec(6000)


# ============================================================
# t = 11.0 s
# Restore high-mu road
# ============================================================

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 11.00 s | RECOVERY"
)


# ============================================================
# t = 11.0 ... 13.0 s
# Recovery observation
# ============================================================

hil.wait_msec(2000)


# ============================================================
# t = 13.0 s
# Speed control OFF
# ============================================================

hil.model_write(
    "speed_enable",
    0
)

print(
    "TE01 | t = 13.00 s | SPEED CONTROL OFF"
)


# ============================================================
# t = 13.5 s
# Motor OFF
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "motor_enable",
    0
)

print(
    "TE01 | t = 13.50 s | MOTOR OFF"
)


# ============================================================
# t = 14.0 s
# Return system to clean state
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "nr",
    0.0
)

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 14.00 s | RESET"
)

hil.model_write(
    "road_surface_model.noise std",
    0.0
)

hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)

print(
    "TE01 | TEST COMPLETE"
)]]></on_click_code>
