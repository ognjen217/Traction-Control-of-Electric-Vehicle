        <component_data>
                <id>548da511382146389cf87f86d20018ae</id>
                <name><![CDATA[STEP_FL_LOW_auto_test4]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ============================================================
# N01_NOISE
# Slip measurement noise sensitivity test
#
# 0.0 s   reset, mu = 0.8 / 0.8, nr = 1.10
# 0.5 s   motor ON
# 1.0 s   speed control ON
# 5.0 s   STEP_FL_LOW: mu = 0.2 / 0.8
# 13.0 s  recovery: mu = 0.8 / 0.8
# 18.0 s  speed control OFF
# 18.5 s  motor OFF
# 19.0 s  reset references / noise
#
# Recommended runs:
#   NOISE_STD = 0.000
#   NOISE_STD = 0.002
#   NOISE_STD = 0.005
#   NOISE_STD = 0.010
# ============================================================


NR_HIGH = 1.10

MU_HIGH = 0.80
MU_LOW  = 0.20

# ============================================================
# SELECT NOISE LEVEL FOR THIS RUN
# ============================================================

NOISE_STD = 0.005


# ============================================================
# t = 0.0 s
# Initial state
# ============================================================

hil.model_write("motor_enable", 0)
hil.model_write("speed_enable", 0)

hil.model_write("nr", NR_HIGH)

hil.model_write(
    "road_surface_model.mu_scalefl",
    MU_HIGH
)

hil.model_write(
    "road_surface_model.mu_scalefr",
    MU_HIGH
)

hil.model_write("tc_enable", 1)


# ------------------------------------------------------------
# Set measurement-noise level
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.noise std",
    NOISE_STD
)


# ------------------------------------------------------------
# Deterministically reset PRNG
#
# This ensures that PID and FOPID receive the same
# pseudo-random noise sequence for the same NOISE_STD.
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)


print(
    "N01 | t = 0.0 s | RESET | "
    "mu = 0.80 / 0.80 | "
    "nr = 1.10 | "
    "noise sigma = {:.4f}".format(NOISE_STD)
)


# ============================================================
# t = 0.5 s
# Motor ON
#
# 10 ms already elapsed during PRNG reset,
# therefore wait another 490 ms.
# ============================================================

hil.wait_msec(490)

hil.model_write(
    "motor_enable",
    1
)

print(
    "N01 | t = 0.5 s | MOTOR ON"
)


# ============================================================
# t = 1.0 s
# Speed control ON
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "speed_enable",
    1
)

print(
    "N01 | t = 1.0 s | SPEED CONTROL ON"
)


# ============================================================
# t = 5.0 s
# STEP_FL_LOW
#
# FL -> low mu
# FR -> remains high mu
# ============================================================

hil.wait_msec(4000)

hil.model_write(
    "road_surface_model.mu_scalefl",
    MU_LOW
)

hil.model_write(
    "road_surface_model.mu_scalefr",
    MU_HIGH
)

print(
    "N01 | t = 5.0 s | STEP_FL_LOW | "
    "mu = 0.20 / 0.80 | "
    "noise sigma = {:.4f}".format(NOISE_STD)
)


# ============================================================
# t = 5.0 ... 13.0 s
# Sustained low-mu interval
# ============================================================

hil.wait_msec(8000)


# ============================================================
# t = 13.0 s
# Recovery
# ============================================================

hil.model_write(
    "road_surface_model.mu_scalefl",
    MU_HIGH
)

hil.model_write(
    "road_surface_model.mu_scalefr",
    MU_HIGH
)

print(
    "N01 | t = 13.0 s | RECOVERY | "
    "mu = 0.80 / 0.80"
)


# ============================================================
# t = 18.0 s
# Speed control OFF
# ============================================================

hil.wait_msec(5000)

hil.model_write(
    "speed_enable",
    0
)

print(
    "N01 | t = 18.0 s | SPEED CONTROL OFF"
)


# ============================================================
# t = 18.5 s
# Motor OFF
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "motor_enable",
    0
)

print(
    "N01 | t = 18.5 s | MOTOR OFF"
)


# ============================================================
# t = 19.0 s
# Return model to clean initial state
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "nr",
    0.0
)

hil.model_write(
    "road_surface_model.mu_scalefl",
    MU_HIGH
)

hil.model_write(
    "road_surface_model.mu_scalefr",
    MU_HIGH
)

hil.model_write(
    "road_surface_model.noise std",
    0.0
)

# Reset PRNG again so model is left in deterministic state
hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)

print(
    "N01 | t = 19.0 s | TEST COMPLETE"
)]]></on_click_code>
                <on_start_code active="False"><![CDATA[
]]></on_start_code>
                <on_timer_code active="False"><![CDATA[
]]></on_timer_code>
                <run_each>250</run_each>
                <on_stop_code active="True"><![CDATA[
hil.model_write("speed_enable", 0.0)
hil.model_write("motor_enable", 0.0)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", 0.8)
hil.model_write("road_surface_model.mu_scalefr", 0.8)
]]></on_stop_code>
                <widget_settings>
                    <x>640</x>
                    <y>752</y>
                    <width>200</width>
                    <height>40</height>
                    <appearance><![CDATA[Flat]]></appearance>
                    <hierarchy_position><![CDATA[1]]></hierarchy_position>
                    <is_background><![CDATA[False]]></is_background>
                    <label><![CDATA[NOICE SCENARIO]]></label>
                    <use_label>True</use_label>
                    <enabled>True</enabled>
                </widget_settings>
            </component_data>
        <component_data>
                <id>b65a20d5cea04180976ac10aef39f69b</id>
                <name><![CDATA[STEP_FL_LOW_auto_test5]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ============================================================
# V02_RAPID_SWITCH_HIGH_TORQUE
#
# Goal:
#   Stress-test TC activation/deactivation, hysteresis and
#   per-wheel selectivity during rapid road-surface changes
#   while positive drive torque demand is high.
#
# Timeline:
#
# 0.0 s   reset
#         mu = 0.80 / 0.80
#         nr = 0.35
#         motor OFF
#         speed control OFF
#
# 0.5 s   motor ON
# 1.0 s   speed control ON
#
# 4.5 s   nr -> 1.10
#         creates strong positive acceleration / torque demand
#
# 5.0 s   rapid road switching starts
#         dwell = 250 ms
#
# 8.5 s   final recovery, mu = 0.80 / 0.80
#
# 11.0 s  speed control OFF
# 11.5 s  motor OFF
# 12.0 s  reset
# ============================================================


NR_LOW  = 0.35
NR_HIGH = 1.10

MU_HIGH = 0.80
MU_LOW  = 0.20

DWELL_MS = 250


# ============================================================
# Helper
# ============================================================

def set_mu(mu_fl, mu_fr, label):
    hil.model_write(
        "road_surface_model.mu_scalefl",
        mu_fl
    )

    hil.model_write(
        "road_surface_model.mu_scalefr",
        mu_fr
    )

    print(
        "V02 | {} | mu = {:.2f} / {:.2f}".format(
            label,
            mu_fl,
            mu_fr
        )
    )


# ============================================================
# t = 0.0 s
# Initial state
# ============================================================

hil.model_write("motor_enable", 0)
hil.model_write("speed_enable", 0)
hil.model_write("tc_enable", 1)

hil.model_write("nr", NR_LOW)

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 0.00 s | INITIAL"
)


# ------------------------------------------------------------
# Disable measurement noise for this experiment
# ------------------------------------------------------------

hil.model_write(
    "road_surface_model.noise std",
    0.0
)

# Reset PRNG / noise model
hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)


# ============================================================
# t = 0.5 s
# Motor ON
# ============================================================

hil.wait_msec(490)

hil.model_write(
    "motor_enable",
    1
)

print(
    "V02 | t = 0.50 s | MOTOR ON"
)


# ============================================================
# t = 1.0 s
# Speed control ON
#
# Vehicle first settles toward lower speed reference.
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "speed_enable",
    1
)

print(
    "V02 | t = 1.00 s | SPEED CONTROL ON | nr = 0.35"
)


# ============================================================
# t = 4.5 s
# Large positive speed-demand step
# ============================================================

hil.wait_msec(3500)

hil.model_write(
    "nr",
    NR_HIGH
)

print(
    "V02 | t = 4.50 s | HIGH TORQUE REQUEST | nr = 1.10"
)


# Allow 500 ms for the speed regulator to establish
# a strong positive q-current request.
hil.wait_msec(500)


# ============================================================
# RAPID SWITCHING SEQUENCE
# ============================================================


# ------------------------------------------------------------
# t = 5.00 s
# FL loses grip
# ------------------------------------------------------------

set_mu(
    MU_LOW,
    MU_HIGH,
    "t = 5.00 s | FL LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 5.25 s
# Split-mu swaps to FR
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_LOW,
    "t = 5.25 s | FR LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 5.50 s
# Both wheels low
# ------------------------------------------------------------

set_mu(
    MU_LOW,
    MU_LOW,
    "t = 5.50 s | BOTH LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 5.75 s
# Full recovery
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 5.75 s | BOTH HIGH"
)

hil.wait_msec(DWELL_MS)


# ============================================================
# SECOND RAPID CYCLE
# ============================================================


# ------------------------------------------------------------
# t = 6.00 s
# FR low first
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_LOW,
    "t = 6.00 s | FR LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 6.25 s
# Immediate swap to FL
# ------------------------------------------------------------

set_mu(
    MU_LOW,
    MU_HIGH,
    "t = 6.25 s | FL LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 6.50 s
# Both low
# ------------------------------------------------------------

set_mu(
    MU_LOW,
    MU_LOW,
    "t = 6.50 s | BOTH LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 6.75 s
# Both high
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 6.75 s | BOTH HIGH"
)

hil.wait_msec(DWELL_MS)


# ============================================================
# THIRD SEQUENCE
#
# Separate short disturbances to specifically exercise
# activation -> release -> activation behavior.
# ============================================================


# ------------------------------------------------------------
# t = 7.00 s
# FL low
# ------------------------------------------------------------

set_mu(
    MU_LOW,
    MU_HIGH,
    "t = 7.00 s | FL LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 7.25 s
# Recovery
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 7.25 s | BOTH HIGH"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 7.50 s
# FR low
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_LOW,
    "t = 7.50 s | FR LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 7.75 s
# Recovery
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 7.75 s | BOTH HIGH"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 8.00 s
# Final symmetric low-mu disturbance
# ------------------------------------------------------------

set_mu(
    MU_LOW,
    MU_LOW,
    "t = 8.00 s | BOTH LOW"
)

hil.wait_msec(DWELL_MS)


# ------------------------------------------------------------
# t = 8.25 s
# Final release
# ------------------------------------------------------------

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 8.25 s | FINAL RELEASE"
)

hil.wait_msec(DWELL_MS)


# ============================================================
# t = 8.50 s
# Stable recovery period
# ============================================================

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 8.50 s | RECOVERY WINDOW"
)


# ============================================================
# t = 11.0 s
# Speed control OFF
# ============================================================

hil.wait_msec(2500)

hil.model_write(
    "speed_enable",
    0
)

print(
    "V02 | t = 11.00 s | SPEED CONTROL OFF"
)


# ============================================================
# t = 11.5 s
# Motor OFF
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "motor_enable",
    0
)

print(
    "V02 | t = 11.50 s | MOTOR OFF"
)


# ============================================================
# t = 12.0 s
# Return system to clean initial state
# ============================================================

hil.wait_msec(500)

hil.model_write(
    "nr",
    0.0
)

set_mu(
    MU_HIGH,
    MU_HIGH,
    "t = 12.00 s | RESET"
)

hil.model_write(
    "road_surface_model.noise std",
    0.0
)

hil.model_write(
    "road_surface_model.reset",
    1
)

hil.wait_msec(10)

hil.model_write(
    "road_surface_model.reset",
    0
)

print(
    "V02 | TEST COMPLETE"
)]]></on_click_code>
                <on_start_code active="False"><![CDATA[
]]></on_start_code>
                <on_timer_code active="False"><![CDATA[
]]></on_timer_code>
                <run_each>250</run_each>
                <on_stop_code active="True"><![CDATA[
hil.model_write("speed_enable", 0.0)
hil.model_write("motor_enable", 0.0)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", 0.8)
hil.model_write("road_surface_model.mu_scalefr", 0.8)
]]></on_stop_code>
                <widget_settings>
                    <x>640</x>
