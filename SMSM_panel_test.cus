        <component_data>
                <id>641fe0bc850711f19cd2bcf105c90459</id>
                <name><![CDATA[SEQMU_auto_test]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized 21 s sequential-mu traction-control test. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[
# Standardized SEQMU test.
# No Python time/timer module is used.
# Typhoon HIL wait_msec() is used to space the commands deterministically.
#
# Before clicking:
#   tc_enable = 0 -> baseline
#   tc_enable = 1 -> FOPID test

SEQMU_NR = 1.10
MU_HIGH = 0.80
MU_LOW = 0.20

# Read requested TC mode before initializing the test.
try:
    tc_requested = float(hil.model_read("tc_enable"))
except Exception:
    tc_requested = 1.0

if tc_requested >= 0.5:
    tc_requested = 1.0
else:
    tc_requested = 0.0

# t = 0.0 s
hil.model_write("motor_enable", 0.0)
hil.model_write("speed_enable", 0.0)
hil.model_write("nr", SEQMU_NR)
hil.model_write("tc_enable", tc_requested)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf("SEQMU: START | TC={} | nr={} | mu=0.8/0.8".format(
    int(tc_requested), SEQMU_NR))

# t = 0.5 s
hil.wait_msec(500)
hil.model_write("motor_enable", 1.0)
printf("SEQMU: t=0.5 s | motor ON")

# t = 1.0 s
hil.wait_msec(500)
hil.model_write("speed_enable", 1.0)
hil.model_write("nr", SEQMU_NR)
hil.model_write("tc_enable", tc_requested)
printf("SEQMU: t=1.0 s | speed ON | nr={} | TC={}".format(
    SEQMU_NR, int(tc_requested)))

# t = 4.0 s
hil.wait_msec(3000)
hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)
printf("SEQMU: t=4.0 s | road mu FL/FR = 0.2/0.8")

# t = 8.0 s
hil.wait_msec(4000)
hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)
printf("SEQMU: t=8.0 s | road mu FL/FR = 0.2/0.2")

# t = 12.0 s
hil.wait_msec(4000)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)
printf("SEQMU: t=12.0 s | road mu FL/FR = 0.8/0.2")

# t = 16.0 s
hil.wait_msec(4000)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)
printf("SEQMU: t=16.0 s | road mu FL/FR = 0.8/0.8")

# t = 20.0 s
hil.wait_msec(4000)
hil.model_write("speed_enable", 0.0)
printf("SEQMU: t=20.0 s | speed OFF")

# t = 20.5 s
hil.wait_msec(500)
hil.model_write("motor_enable", 0.0)
printf("SEQMU: t=20.5 s | motor OFF")

# t = 21.0 s
hil.wait_msec(500)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)
printf("SEQMU: END | t=21.0 s")
]]></on_click_code>
                <on_start_code active="False"><![CDATA[
]]></on_start_code>
                <on_timer_code active="False"><![CDATA[
]]></on_timer_code>
                <run_each>250</run_each>
                <on_stop_code active="True"><![CDATA[
# Safe reset when simulation is stopped.
hil.model_write("speed_enable", 0.0)
hil.model_write("motor_enable", 0.0)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", 0.8)
hil.model_write("road_surface_model.mu_scalefr", 0.8)
]]></on_stop_code>
                <widget_settings>
                    <x>640</x>
                    <y>512</y>
                    <width>200</width>
                    <height>40</height>
                    <appearance><![CDATA[Flat]]></appearance>
                    <hierarchy_position><![CDATA[1]]></hierarchy_position>
                    <is_background><![CDATA[False]]></is_background>
                    <label><![CDATA[RUN SEQMU AUTO TEST]]></label>
                    <use_label>True</use_label>
                    <enabled>True</enabled>
                </widget_settings>
            </component_data>
        <component_data>
