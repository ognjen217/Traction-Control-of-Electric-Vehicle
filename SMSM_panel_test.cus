        <component_data>
                <id>73e5c4fdb7324a0aa9c5fd26be6b85be</id>
                <name><![CDATA[STEP_FL_LOW_auto_test2]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ============================================================
# AW01_SAT_RELEASE
# Anti-windup / saturation recovery test
#
# 0.0 s   reset state, mu = 0.8 / 0.8, nr = 1.10
# 0.5 s   motor ON
# 1.0 s   speed control ON
# 2.5 s   mu = 0.05 / 0.05  -> force severe slip / saturation
# 7.5 s   mu = 0.8 / 0.8    -> sudden release
# 12.0 s  speed control OFF
# 12.5 s  motor OFF
# 13.0 s  reset references
# ============================================================

NR_HIGH = 1.10

MU_HIGH = 0.80
MU_SAT  = 0.05


# ------------------------------------------------------------
# Initial state - t = 0.0 s
# ------------------------------------------------------------

hil.model_write("motor_enable", 0)
hil.model_write("speed_enable", 0)

hil.model_write("nr", NR_HIGH)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

# TC must be enabled during the whole AW test
hil.model_write("tc_enable", 1)

print("AW01 | t = 0.0 s | RESET | mu = 0.80 / 0.80 | nr = 1.10")


# ------------------------------------------------------------
# t = 0.5 s - motor ON
# ------------------------------------------------------------

hil.wait_msec(500)

hil.model_write("motor_enable", 1)

print("AW01 | t = 0.5 s | MOTOR ON")


# ------------------------------------------------------------
# t = 1.0 s - speed control ON
# ------------------------------------------------------------

hil.wait_msec(500)

hil.model_write("speed_enable", 1)

print("AW01 | t = 1.0 s | SPEED CONTROL ON")


# ------------------------------------------------------------
# t = 2.5 s - severe low-mu event
# ------------------------------------------------------------

hil.wait_msec(1500)

hil.model_write("road_surface_model.mu_scalefl", MU_SAT)
hil.model_write("road_surface_model.mu_scalefr", MU_SAT)

print("AW01 | t = 2.5 s | SATURATION EVENT | mu = 0.05 / 0.05")


# ------------------------------------------------------------
# Hold severe low-mu condition for 5 s
# t = 2.5 ... 7.5 s
# ------------------------------------------------------------

hil.wait_msec(5000)


# ------------------------------------------------------------
# t = 7.5 s - sudden recovery
#
# IMPORTANT:
# motor_enable stays ON
# speed_enable stays ON
# nr stays at 1.10
#
# Therefore the controller state is NOT reset.
# ------------------------------------------------------------

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

print("AW01 | t = 7.5 s | RELEASE | mu = 0.80 / 0.80")


# ------------------------------------------------------------
# Recovery observation window
# t = 7.5 ... 12.0 s
# ------------------------------------------------------------

hil.wait_msec(4500)


# ------------------------------------------------------------
# t = 12.0 s - speed control OFF
# ------------------------------------------------------------

hil.model_write("speed_enable", 0)

print("AW01 | t = 12.0 s | SPEED CONTROL OFF")


# ------------------------------------------------------------
# t = 12.5 s - motor OFF
# ------------------------------------------------------------

hil.wait_msec(500)

hil.model_write("motor_enable", 0)

print("AW01 | t = 12.5 s | MOTOR OFF")


# ------------------------------------------------------------
# t = 13.0 s - return SCADA references to safe initial state
# ------------------------------------------------------------

hil.wait_msec(500)

hil.model_write("nr", 0.0)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

print("AW01 | t = 13.0 s | TEST COMPLETE")]]></on_click_code>
                <on_start_code active="False"><![CDATA[
]]></on_start_code>
                <on_timer_code active="False"><![CDATA[
]]></on_timer_code>
                <run_each>250</run_each>
                <on_stop_code active="True"><![CDATA[
hil.model_write("speed_enable", 0.0)
hil.model_write("motor_enable", 0.0)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", 0.8)
hil.model_write("road_surface_model.mu_scalefr", 0.8)
]]></on_stop_code>
