        <component_data>
                <id>6434e21b7dcf4684a066f38d6d3e4c72</id>
                <name><![CDATA[STEP_FL_LOW_auto_test]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[
# STEP_FL_LOW standardized test
#
# Purpose:
#   isolate traction-control transient response on the FL wheel.
#
# Before clicking:
#   tc_enable = 0 -> baseline
#   tc_enable = 1 -> FOPID test

NR = 1.10
MU_HIGH = 0.80
MU_LOW = 0.20

# Read requested TC mode.
try:
    tc_requested = float(hil.model_read("tc_enable"))
except Exception:
    tc_requested = 1.0

if tc_requested >= 0.5:
    tc_requested = 1.0
else:
    tc_requested = 0.0

# t = 0.0 s -- deterministic initial condition
hil.model_write("motor_enable", 0.0)
hil.model_write("speed_enable", 0.0)
hil.model_write("nr", NR)
hil.model_write("tc_enable", tc_requested)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf("STEP_FL_LOW: START | TC={} | nr={} | mu FL/FR=0.8/0.8".format(
    int(tc_requested), NR))

# t = 0.5 s
hil.wait_msec(500)
hil.model_write("motor_enable", 1.0)
printf("STEP_FL_LOW: t=0.5 s | motor ON")

# t = 1.0 s
hil.wait_msec(500)
hil.model_write("speed_enable", 1.0)
hil.model_write("nr", NR)
hil.model_write("tc_enable", tc_requested)
printf("STEP_FL_LOW: t=1.0 s | speed ON | nr={} | TC={}".format(
    NR, int(tc_requested)))

# t = 5.0 s -- low-mu step on FL only
hil.wait_msec(4000)
hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)
printf("STEP_FL_LOW: t=5.0 s | STEP DOWN | mu FL/FR=0.2/0.8")

# Hold low-mu condition for 8 seconds.
# t = 13.0 s -- restore FL grip
hil.wait_msec(8000)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)
printf("STEP_FL_LOW: t=13.0 s | RECOVERY | mu FL/FR=0.8/0.8")

# Observe recovery for 5 seconds.
# t = 18.0 s
hil.wait_msec(5000)
hil.model_write("speed_enable", 0.0)
printf("STEP_FL_LOW: t=18.0 s | speed OFF")

# t = 18.5 s
hil.wait_msec(500)
hil.model_write("motor_enable", 0.0)
printf("STEP_FL_LOW: t=18.5 s | motor OFF")

# t = 19.0 s
hil.wait_msec(500)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)
printf("STEP_FL_LOW: END | t=19.0 s")
]]></on_click_code>
                <on_start_code active="False"><![CDATA[
]]></on_start_code>
                <on_timer_code active="False"><![CDATA[
]]></on_timer_code>
                <run_each>250</run_each>
                <on_stop_code active="True"><![CDATA[
hil.model_write("speed_enable", 0.0)
hil.model_write("motor_enable", 0.0)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", 0.8)
hil.model_write("road_surface_model.mu_scalefr", 0.8)
]]></on_stop_code>
                <widget_settings>
                    <x>640</x>
                    <y>560</y>
                    <width>200</width>
                    <height>40</height>
                    <appearance><![CDATA[Flat]]></appearance>
                    <hierarchy_position><![CDATA[1]]></hierarchy_position>
                    <is_background><![CDATA[False]]></is_background>
                    <label><![CDATA[RUN STEP FL LOW]]></label>
                    <use_label>True</use_label>
                    <enabled>True</enabled>
                </widget_settings>
            </component_data>
        <component_data>
                <id>467861d92d8e47c69382bdc542ccd380</id>
                <name><![CDATA[STEP_FL_LOW_auto_test1]]></name>
                <type>Macro</type>
                <description><![CDATA[Standardized single-wheel low-mu step test. FL: 0.8 -> 0.2 -> 0.8, FR remains at 0.8. Set tc_enable to 0 or 1 before pressing RUN.]]></description>
                <on_click_code active="True"><![CDATA[# ================================================================
# COMPREHENSIVE_BOUNDARY_50S
# Comprehensive traction-control validation test
#
# Purpose:
#   Stress-test the complete TC/FOPID implementation using:
#     - high-mu operation
#     - FL split-mu
#     - FR split-mu
#     - symmetric low-mu
#     - medium-mu operation
#     - recovery
#     - negative torque demand
#     - aggressive re-acceleration
#     - rapid left/right road changes
#     - simultaneous speed-reference and adhesion disturbance
#
# Recommended FOPID configuration:
#   Kp     = 780
#   Ki     = 4800
#   Kd     = 25
#   lambda = 0.40
#   mu     = 0.70
#   M      = 50
#
# Total duration: 50 s
# ================================================================


NR_HIGH = 1.10
NR_MID  = 0.55
NR_LOW  = 0.25
NR_PRE_ACCEL = 0.35

MU_HIGH = 0.80
MU_MED  = 0.45
MU_PART = 0.35
MU_LOW  = 0.20


# ------------------------------------------------
# Preserve requested TC mode
# ------------------------------------------------

try:
    tc_requested = float(hil.model_read("tc_enable"))
except Exception:
    tc_requested = 1.0

if tc_requested >= 0.5:
    tc_requested = 1.0
else:
    tc_requested = 0.0


# ================================================================
# t = 0.0 s
# Deterministic initial condition
# ================================================================

hil.model_write("motor_enable", 0.0)
hil.model_write("speed_enable", 0.0)

hil.model_write("nr", NR_HIGH)
hil.model_write("tc_enable", tc_requested)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf(
    "BOUNDARY50: START | TC={} | nr={} | mu FL/FR={}/{}".format(
        int(tc_requested), NR_HIGH, MU_HIGH, MU_HIGH
    )
)


# ================================================================
# t = 0.5 s
# Motor ON
# ================================================================

hil.wait_msec(500)

hil.model_write("motor_enable", 1.0)

printf("BOUNDARY50: t=0.5 | MOTOR ON")


# ================================================================
# t = 1.0 s
# Speed controller ON
# Normal acceleration on high-mu
# ================================================================

hil.wait_msec(500)

hil.model_write("speed_enable", 1.0)
hil.model_write("nr", NR_HIGH)
hil.model_write("tc_enable", tc_requested)

printf(
    "BOUNDARY50: t=1.0 | SPEED ON | nr={} | high-mu acceleration".format(
        NR_HIGH
    )
)


# ================================================================
# t = 5.0 s
# SCENARIO 1:
# FL sudden grip loss
#
# Tests:
#   - FL-only detection
#   - independent wheel intervention
#   - onset transient
# ================================================================

hil.wait_msec(4000)

hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf(
    "BOUNDARY50: t=5.0 | S1 FL LOW | mu FL/FR={}/{}".format(
        MU_LOW, MU_HIGH
    )
)


# ================================================================
# t = 9.0 s
# SCENARIO 2:
# Instantaneous split-mu reversal
#
# FL recovers at exactly the same time that FR loses grip.
#
# Tests:
#   - fast release FL
#   - fast activation FR
#   - cross-wheel independence
# ================================================================

hil.wait_msec(4000)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)

printf(
    "BOUNDARY50: t=9.0 | S2 SPLIT SWAP | mu FL/FR={}/{}".format(
        MU_HIGH, MU_LOW
    )
)


# ================================================================
# t = 13.0 s
# SCENARIO 3:
# BOTH wheels on very low mu
#
# Severe symmetric traction event.
#
# Tests:
#   - simultaneous FL/FR regulation
#   - maximum TC authority
#   - saturation / current reduction
# ================================================================

hil.wait_msec(4000)

hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)

printf(
    "BOUNDARY50: t=13.0 | S3 BOTH LOW | mu FL/FR={}/{}".format(
        MU_LOW, MU_LOW
    )
)


# ================================================================
# t = 17.0 s
# SCENARIO 4:
# Partial recovery to medium mu
#
# Tests:
#   - adaptation to non-extreme road
#   - reduction release
#   - operation away from binary 0.2 / 0.8 cases
# ================================================================

hil.wait_msec(4000)

hil.model_write("road_surface_model.mu_scalefl", MU_MED)
hil.model_write("road_surface_model.mu_scalefr", MU_MED)

printf(
    "BOUNDARY50: t=17.0 | S4 MEDIUM MU | mu FL/FR={}/{}".format(
        MU_MED, MU_MED
    )
)


# ================================================================
# t = 20.0 s
# SCENARIO 5:
# Full road recovery
#
# Tests:
#   - TC release
#   - residual reduction
#   - recovery tail
# ================================================================

hil.wait_msec(3000)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf(
    "BOUNDARY50: t=20.0 | S5 FULL RECOVERY | mu FL/FR={}/{}".format(
        MU_HIGH, MU_HIGH
    )
)


# ================================================================
# t = 23.0 s
# SCENARIO 6:
# Speed reference step DOWN
#
# Vehicle should demand reduced / negative torque.
#
# Tests:
#   - positive-torque TC gating
#   - TC must NOT fight braking / negative Iq
# ================================================================

hil.wait_msec(3000)

hil.model_write("nr", NR_MID)

printf(
    "BOUNDARY50: t=23.0 | S6 SPEED STEP DOWN | nr={}".format(
        NR_MID
    )
)


# ================================================================
# t = 26.0 s
# SCENARIO 7:
# Stronger negative torque demand
#
# Tests:
#   - boundary negative-slip behavior
#   - TC inactivity for braking torque
# ================================================================

hil.wait_msec(3000)

hil.model_write("nr", NR_LOW)

printf(
    "BOUNDARY50: t=26.0 | S7 STRONG DECELERATION | nr={}".format(
        NR_LOW
    )
)


# ================================================================
# t = 29.0 s
# SCENARIO 8:
# Aggressive re-acceleration on GOOD road
#
# Establish control reference before next adhesion event.
# ================================================================

hil.wait_msec(3000)

hil.model_write("nr", NR_HIGH)

printf(
    "BOUNDARY50: t=29.0 | S8 RE-ACCEL HIGH MU | nr={}".format(
        NR_HIGH
    )
)


# ================================================================
# t = 32.0 s
# SCENARIO 9:
# BOTH wheels abruptly lose grip during strong acceleration
#
# One of the most severe TC scenarios.
#
# Tests:
#   - simultaneous high torque demand
#   - large slip transient
#   - TC authority
#   - stabilization
# ================================================================

hil.wait_msec(3000)

hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)

printf(
    "BOUNDARY50: t=32.0 | S9 FULL LOW-MU DURING ACCEL | mu FL/FR={}/{}".format(
        MU_LOW, MU_LOW
    )
)


# ================================================================
# t = 36.0 s
# SCENARIO 10:
# FL partially recovers, FR completely recovers
#
# Tests intermediate asymmetric road.
# ================================================================

hil.wait_msec(4000)

hil.model_write("road_surface_model.mu_scalefl", MU_PART)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf(
    "BOUNDARY50: t=36.0 | S10 PARTIAL SPLIT | mu FL/FR={}/{}".format(
        MU_PART, MU_HIGH
    )
)


# ================================================================
# t = 38.0 s
# Reverse partial split
# ================================================================

hil.wait_msec(2000)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_PART)

printf(
    "BOUNDARY50: t=38.0 | S10b PARTIAL SPLIT SWAP | mu FL/FR={}/{}".format(
        MU_HIGH, MU_PART
    )
)


# ================================================================
# t = 39.0 s
#
# SCENARIO 11:
# RAPID ROAD-SURFACE SWITCHING
#
# 500 ms surface changes.
#
# Tests:
#   - hysteresis
#   - activation/deactivation chatter
#   - FL/FR state independence
#   - derivative sensitivity
# ================================================================

hil.wait_msec(1000)

hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf("BOUNDARY50: t=39.0 | S11 RAPID 1 | mu FL/FR=0.2/0.8")


# t = 39.5

hil.wait_msec(500)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)

printf("BOUNDARY50: t=39.5 | S11 RAPID 2 | mu FL/FR=0.8/0.2")


# t = 40.0

hil.wait_msec(500)

hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)

printf("BOUNDARY50: t=40.0 | S11 RAPID 3 | mu FL/FR=0.2/0.2")


# t = 40.5

hil.wait_msec(500)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf("BOUNDARY50: t=40.5 | S11 RAPID 4 | mu FL/FR=0.8/0.8")


# ================================================================
# t = 41.0 s
# Short recovery / observation
# ================================================================

hil.wait_msec(500)

printf("BOUNDARY50: t=41.0 | RAPID SWITCH COMPLETE")


# ================================================================
# t = 43.0 s
#
# SCENARIO 12:
# Strong speed-reference reduction on GOOD road
#
# Prepare vehicle for final worst-case event.
# ================================================================

hil.wait_msec(2000)

hil.model_write("nr", NR_PRE_ACCEL)

printf(
    "BOUNDARY50: t=43.0 | S12 PRE-FINAL DECEL | nr={}".format(
        NR_PRE_ACCEL
    )
)


# ================================================================
# t = 45.0 s
#
# SCENARIO 13 — COMBINED WORST-CASE EVENT
#
# Simultaneously:
#   1. command strong acceleration
#   2. drop BOTH road surfaces to low mu
#
# Tests:
#   - simultaneous reference disturbance
#   - simultaneous plant disturbance
#   - maximum positive torque request
#   - large slip onset
#   - FOPID transient robustness
# ================================================================

hil.wait_msec(2000)

hil.model_write("road_surface_model.mu_scalefl", MU_LOW)
hil.model_write("road_surface_model.mu_scalefr", MU_LOW)

hil.model_write("nr", NR_HIGH)

printf(
    "BOUNDARY50: t=45.0 | S13 WORST CASE | nr={} | mu FL/FR={}/{}".format(
        NR_HIGH, MU_LOW, MU_LOW
    )
)


# ================================================================
# t = 48.0 s
#
# FINAL RECOVERY
# ================================================================

hil.wait_msec(3000)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf(
    "BOUNDARY50: t=48.0 | FINAL RECOVERY | mu FL/FR={}/{}".format(
        MU_HIGH, MU_HIGH
    )
)


# ================================================================
# t = 49.0 s
# Speed regulator OFF
# ================================================================

hil.wait_msec(1000)

hil.model_write("speed_enable", 0.0)

printf("BOUNDARY50: t=49.0 | SPEED OFF")


# ================================================================
# t = 49.5 s
# Motor OFF
# ================================================================

hil.wait_msec(500)

hil.model_write("motor_enable", 0.0)

printf("BOUNDARY50: t=49.5 | MOTOR OFF")


# ================================================================
# t = 50.0 s
# Safe reset
# ================================================================

hil.wait_msec(500)

hil.model_write("nr", 0.0)

hil.model_write("road_surface_model.mu_scalefl", MU_HIGH)
hil.model_write("road_surface_model.mu_scalefr", MU_HIGH)

printf("BOUNDARY50: END | t=50.0 s")]]></on_click_code>
                <on_start_code active="False"><![CDATA[
]]></on_start_code>
                <on_timer_code active="False"><![CDATA[
]]></on_timer_code>
                <run_each>250</run_each>
                <on_stop_code active="True"><![CDATA[
hil.model_write("speed_enable", 0.0)
hil.model_write("motor_enable", 0.0)
hil.model_write("nr", 0.0)
hil.model_write("road_surface_model.mu_scalefl", 0.8)
hil.model_write("road_surface_model.mu_scalefr", 0.8)
]]></on_stop_code>
